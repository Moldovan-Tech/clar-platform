# Variables de compilación de la app (Vite). Copia este archivo a `.env.local` si necesitas alguna en local;
# ninguna es obligatoria y `.env.local` no se sube a git.

# Clave pública VAPID de Firebase Cloud Messaging (Configuración del proyecto → Cloud Messaging → Certificados web
# push). Sin ella no aparece «Avisarme también con CLAR cerrada». En la CI sale de la variable del repositorio
# FCM_VAPID_KEY. Es pública, pero no hace falta en local: con los emuladores la opción no aparece.
VITE_FCM_VAPID_KEY=

# Id del cliente OAuth de Google (público). Sin él no se ofrece conectar Google Calendar. En la CI sale de la
# variable del repositorio GOOGLE_OAUTH_CLIENT_ID. Con los emuladores la conexión no funciona: el servidor la rechaza.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# «true» conecta la app a los emuladores de Firebase. Ya lo ponen `npm run dev` y `npm run emulators`.
VITE_USE_FIREBASE_EMULATORS=

# Los parámetros de las Cloud Functions (ADMIN_EMAIL, SMTP_USER, ANDROID_PACKAGE_NAME…) no van aquí: los pide
# `firebase deploy` y se guardan en functions/.env.<id-del-proyecto> (ver «Despliegue» en el README).
